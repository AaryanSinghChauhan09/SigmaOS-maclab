<?xml version="1.0" encoding="UTF-8"?>
<!-- The Out-of-band controller on the mini, as root: the reset tool needs it.
     One process for the three rear ports, on a loopback port only, run from
     the build Deploy switched to. scripts/mini/setup installs this file and
     starts it. Nothing here is a secret: the token is in the file named,
     which only root reads. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.maclab.oobd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/lab/current/bin/oobd</string>
    <string>--listen</string><string>127.0.0.1:7780</string>
    <string>--token-file</string><string>/usr/local/lab/secrets/oobd.token</string>
    <string>--tool</string><string>/usr/local/lab/current/bin/macvdmtool</string>
  </array>
  <key>WorkingDirectory</key><string>/var/empty</string>
  <key>Umask</key><integer>63</integer>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/var/log/oobd.log</string>
  <key>StandardErrorPath</key><string>/var/log/oobd.log</string>
</dict>
</plist>
