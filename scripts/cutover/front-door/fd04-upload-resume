#!/bin/bash
# The Front door's test 4: a 1 GB upload in parts, cut mid-part, resumes,
# and its checksum matches (spec section 16, Ready item 1).
#
#   fd04-upload-resume [--dry-run | --local | --lab] [--size BYTES] [--records DIR]
#
# lab upload sends a file of random bytes in 32 MiB parts. The test kills it
# while it sends, starts the same command again and wants lab to say that
# labd holds some of the parts and not all; that run is left to finish, and
# the SHA-256 lab prints must be the file's. labd stores the file only under
# the SHA-256 the upload named, so a wrong byte anywhere fails the close.
#
# The cut is found by trying: the first run is killed after 0.2 s and each
# later one after twice as long, until a run starts by resuming. A run that
# ends before its cut starts over with a new file and an earlier cut. A lab
# that never resumes fails the test after six files.
#
#   --size BYTES   the file's size: 1 GiB through the Lab address,
#                  320 MiB (10 parts) against a local labd
set -euo pipefail
# shellcheck source=scripts/cutover/front-door/lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
usage() { sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

fd_options "$@"
no_rest
if [[ -z $SIZE ]]; then
  if [[ $MODE == local ]]; then SIZE=$((320 << 20)); else SIZE=$GIB; fi
fi
(( SIZE > 2 * PART_BYTES )) || fail "--size $SIZE: the file must be longer than two parts ($((2 * PART_BYTES)) bytes) for a cut to leave some held and some not"
parts=$(( (SIZE + PART_BYTES - 1) / PART_BYTES ))

if [[ $MODE == dry ]]; then
  cat <<EOF
$ME: dry run. Through $ADDRESS, under the saved login, it would:
  1. make a file of $SIZE random bytes ($parts parts of 32 MiB) and take its SHA-256
  2. run: lab upload FILE, and kill it while it sends (after 0.2 s, then twice as long each time)
  3. run: lab upload FILE again, until lab says "resuming: labd holds N of $parts parts" with 0 < N < $parts
  4. let that run finish and compare the SHA-256 lab prints with the file's
  5. write docs/acceptance/$(TZ=Australia/Brisbane date +%Y-%m-%d)-front-door-04.md
Nothing was sent.
EOF
  exit 0
fi

workspace
if [[ $MODE == local ]]; then local_lab; else logged_in; fi
record_start 04 "an upload in parts, cut mid-part, resumes and its checksum matches"

file="$WORK/upload.bin"
err="$WORK/run.err"
out="$WORK/run.out"
held=""
cuts=0
files=0
delay=0.2
pid=""

new_file() {
  random_file "$file" "$SIZE"
  want="$(sha256_of "$file")"
  files=$((files + 1))
  (( files <= 6 )) || { rec "six files went up whole and no run after a cut said it resumed"; record_done fail; exit 1; }
}

# resumed: lab said labd holds some parts of this file and not all; N in held.
resumed() {
  held="$(sed -n 's/^lab: resuming: labd holds \([0-9]*\) of \([0-9]*\) parts$/\1 \2/p' "$err" | head -n 1)"
  [[ -n $held ]] || return 1
  [[ ${held#* } == "$parts" ]] || fail "lab counts ${held#* } parts in a file of $parts"
  held="${held% *}"
  (( held > 0 && held < parts ))
}

running() { kill -0 "$pid" 2>/dev/null; }

new_file
for _ in $(seq 24); do
  : > "$err"
  "$LAB_CMD" upload "$file" > "$out" 2> "$err" &
  pid=$!
  end="$(calc "$(now) + $delay")"
  while running && is "$(now) < $end"; do sleep 0.05; done
  if resumed; then
    start="$(now)"
    wait "$pid" || { rec "the run that resumed failed: $(plain "$err")"; record_done fail; exit 1; }
    got="$(head -n 1 "$out")"
    rec "file: $SIZE bytes, $parts parts of 32 MiB"
    rec "cut: lab upload killed while it sent; cuts: $cuts"
    rec "resume: labd held $held of $parts parts; the same command sent the rest in $(calc "$(now) - $start") s more"
    if [[ $got == "$want" ]]; then
      rec "checksum: the SHA-256 labd stored is the file's"
      record_done pass
      exit 0
    fi
    rec "checksum: labd stored another SHA-256 than the file's"
    record_done fail
    exit 1
  fi
  if running; then
    kill -9 "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    cuts=$((cuts + 1))
    delay="$(calc "$delay * 2")"
    continue
  fi
  # It ended before the cut.
  if ! wait "$pid"; then
    rec "lab upload failed before any cut: $(plain "$err")"
    record_done fail
    exit 1
  fi
  # Whole, with no part held when it started: every cut so far fell before
  # the first part was stored, or after the last. Another file, a cut a
  # little earlier.
  new_file
  cuts=0
  delay="$(calc "$delay * 0.75")"
done
rec "no run resumed in 24 tries"
record_done fail
exit 1
