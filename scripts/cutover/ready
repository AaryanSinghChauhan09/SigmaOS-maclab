#!/bin/bash
# The Ready report: which of the nine items of the Ready list (spec section
# 16) are green, read from the dated records under docs/acceptance/.
#
#   ready [--records DIR]
#
# It runs nothing and reaches nothing: it reads files. Exit 0 only when all
# nine are green; the day's script (scripts/cutover/day) asks it before
# step 18.
#
# An item is green by its results file, where its tests keep one
# (out-of-band.results, hardening.results, builder-gate.results: a line for
# each test, "NAME RESULT DATE RECORD", every one pass), or by its newest
# dated record, DATE-NAME.md, whose last line that starts "Result:" says
# pass. A record the owner files by hand gets that line from the owner.
#
#   1 the Front door's fourteen tests     DATE-front-door.md, "pass, all fourteen"
#   2 Out-of-band wiring's eight tests    out-of-band.results, 01 to 08
#   3 operations                          DATE-restore-drill.md, DATE-dead-man.md,
#                                         DATE-unlock-outside.md, DATE-planned-restart.md,
#                                         DATE-grid-switch.md
#   4 the rehearsal import                DATE-rehearsal-import.md
#   5 one Lease                           DATE-lease.md
#   6 both Lab-owned Macs accepted        DATE-macs-accepted.md
#   7 the Release candidate; step 1 done  DATE-release-candidate.md
#   8 hardening's fourteen tests          hardening.results, 01 to 14
#   9 the Builder's gate test             builder-gate.results
# shellcheck disable=SC2329
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ME=ready
records="$here/../../docs/acceptance"

usage() { sed -n '2,28p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

while (( $# )); do
  case "$1" in
    --records) (( $# >= 2 )) || usage; records="$2"; shift ;;
    *) usage ;;
  esac
  shift
done
[[ -d $records ]] || { echo "$ME: no folder $records" >&2; exit 2; }

WHY=""

# newest NAME: the newest dated record of that name, or nothing.
newest() {
  local f last=""
  for f in "$records"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-"$1".md; do
    [[ -f $f ]] && last="$f"
  done
  printf '%s' "$last"
}

# dated NAME [WORDS]: green when the newest record's last Result line says
# pass (and, with WORDS, exactly "pass, WORDS").
dated() {
  local file result
  file="$(newest "$1")"
  if [[ -z $file ]]; then
    WHY="no record DATE-$1.md"
    return 1
  fi
  result="$(grep '^Result:' "$file" | tail -n 1 | sed 's/^Result: *//')"
  case "$result" in
    "pass, ${2:-}" | pass | "pass, "*)
      if [[ -n ${2:-} && $result != "pass, $2" ]]; then
        WHY="$(basename "$file") says \"${result:0:60}\""
        return 1
      fi
      WHY="$(basename "$file")"
      return 0
      ;;
    "") WHY="$(basename "$file") has no Result line" ;;
    *) WHY="$(basename "$file") says \"${result:0:60}\"" ;;
  esac
  return 1
}

# listed FILE NAME...: green when the results file has a pass for each NAME.
listed() {
  local file="$records/$1" name word bad=""
  shift
  if [[ ! -f $file ]]; then
    WHY="no $(basename "$file")"
    return 1
  fi
  for name in "$@"; do
    word="$(awk -v n="$name" '$1 == n { w = $2 } END { print w }' "$file")"
    [[ $word == pass ]] || bad="$bad $name:${word:-missing}"
  done
  if [[ -n $bad ]]; then
    WHY="$(basename "$file"):$bad"
    return 1
  fi
  WHY="$(basename "$file")"
  return 0
}

operations() {
  local part seen="" bad=""
  for part in restore-drill dead-man unlock-outside planned-restart grid-switch; do
    if dated "$part"; then seen="$seen $WHY"; else bad="$bad $WHY;"; fi
  done
  if [[ -n $bad ]]; then
    WHY="${bad# }"
    WHY="${WHY%;}"
    return 1
  fi
  WHY="five records"
  return 0
}

green=0
item() {
  local n="$1" title="$2"
  shift 2
  if "$@"; then
    echo "Ready $n, $title: green ($WHY)"
    green=$((green + 1))
  else
    echo "Ready $n, $title: not green: $WHY"
  fi
}

item 1 "the Front door's fourteen tests" dated front-door "all fourteen"
item 2 "Out-of-band wiring's eight tests" listed out-of-band.results 01 02 03 04 05 06 07 08
item 3 "operations" operations
item 4 "the rehearsal import" dated rehearsal-import
item 5 "one Lease" dated lease
item 6 "both Lab-owned Macs accepted" dated macs-accepted
item 7 "the Release candidate built; step 1 done" dated release-candidate
item 8 "hardening's fourteen tests" listed hardening.results 01 02 03 04 05 06 07 08 09 10 11 12 13 14
item 9 "the Builder's gate test" listed builder-gate.results builder-gate

if (( green == 9 )); then
  echo "$ME: Ready: all nine items are green"
  exit 0
fi
echo "$ME: not Ready: $green of nine items are green"
exit 1
