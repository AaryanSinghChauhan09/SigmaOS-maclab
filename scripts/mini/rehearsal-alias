#!/bin/bash
# The Alias rehearsal's side of the mini (spec section 16, step 17a). The
# rehearsal runs on a throwaway name under omarchy-m-testing.org, and labd
# forwards one Alias only, the one it is started with:
#
#   sudo scripts/mini/rehearsal-alias NAME.omarchy-m-testing.org
#       Restarts the tunnel with NAME routed in the Alias's place, then labd
#       with NAME as its Alias, whatever the Deployed files say. They stay so
#       until "rehearsal-alias deployed". The lab is Dark for the seconds the
#       two restarts take, and the real Alias is not routed meanwhile.
#   sudo scripts/mini/rehearsal-alias deployed
#       Puts both back under the Deployed files.
#   scripts/mini/rehearsal-alias
#       Says which Alias labd was started with. Changes nothing.
#
# It rewrites the two installed LaunchDaemon files, each in one argument,
# and writes the rehearsal's route file where only root writes. When the
# tunnel or labd does not come up under NAME, both are put back.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/mini/lib.sh
. "$here/lib.sh"
deploy="$(cd "$here/../.." && pwd)/deploy"
usage() { sed -n '2,18p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

labd_plist="$LAUNCHD_DIR/$LABD_LABEL.plist"
tunnel_plist="$LAUNCHD_DIR/$CLOUDFLARED_LABEL.plist"
labd_source="$deploy/$LABD_LABEL.plist"
tunnel_source="$deploy/$CLOUDFLARED_LABEL.plist"
routes="$LAB_CURRENT/deploy/cloudflared.yml"
rehearsal="$LAB_ROOT/rehearsal"

(( $# <= 1 )) || usage
want="${1:-}"
[[ -z $want || $want == deployed || ($want =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.omarchy-m-testing\.org$ && $want != www.omarchy-m-testing.org) ]] || usage
[[ -f $labd_plist && -f $tunnel_plist && -f $labd_source && -f $tunnel_source && -f $routes ]] ||
  fail "labd and the tunnel are not both set up on this machine: nothing was changed"

# arg FILE FLAG: the argument after FLAG in a LaunchDaemon file.
arg() { awk -F'[<>]' -v f="$2" '$0 ~ "<string>" f "</string>" { print $7; exit }' "$1"; }

alias_deployed="$(arg "$labd_source" --alias)"
[[ -n $alias_deployed ]] || fail "labd's Deployed LaunchDaemon file names no Alias: nothing was changed"
alias_now="$(arg "$labd_plist" --alias)"
if [[ -z $want ]]; then
  if [[ $alias_now == "$alias_deployed" ]]; then
    say "labd runs under the Deployed files: its Alias is $alias_deployed"
  else
    say "labd was started with the Alias $alias_now, for the rehearsal; the Deployed files say $alias_deployed"
  fi
  exit 0
fi
need_root

# start LABEL FILE: the daemon under a copy of FILE.
start() {
  local plist="$LAUNCHD_DIR/$1.plist"
  stopped "$1" || fail "$1 did not stop (20 s)"
  cp "$2" "$plist.new"
  chown "$ROOT_OWNER:$ROOT_GROUP" "$plist.new"
  chmod 0644 "$plist.new"
  mv "$plist.new" "$plist"
  launchctl enable "system/$1" || true
  launchctl bootstrap system "$plist" || fail "launchd did not take $plist"
}

# up WHAT: the tunnel holds a connection, or labd answers on its socket.
up() {
  local n
  for (( n = 0; n < ${LAB_READY_TRIES:-30}; n++ )); do
    if [[ $1 == tunnel ]]; then
      if curl -fsS -o /dev/null --max-time 5 "$TUNNEL_READY" 2>/dev/null; then return 0; fi
    elif curl -fsS -o /dev/null --max-time 5 --unix-socket "$LABD_SOCKET" -H 'X-Forwarded-Proto: https' "http://$LAB_HOST/healthz" 2>/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

back() {
  start "$CLOUDFLARED_LABEL" "$tunnel_source"
  start "$LABD_LABEL" "$labd_source"
  rm -rf "$rehearsal"
}

if [[ $want == deployed ]]; then
  back
  up tunnel || fail "the tunnel is back under the Deployed files and has not connected yet: look at $LAB_HOME/log/cloudflared.log"
  up labd || fail "labd is back under the Deployed files and does not answer yet: look at $LABD_LOG"
  say "labd and the tunnel run under the Deployed files again: the Alias is $alias_deployed"
  exit 0
fi

made="$(mktemp -d "${TMPDIR:-/tmp}/rehearsal-alias.XXXXXX")"
trap 'rm -rf "$made"' EXIT
sed "s/^\\( *- hostname: \\)${alias_deployed//./\\.}\$/\\1$want/" "$routes" > "$made/cloudflared.yml"
[[ "$(grep -c "^ *- hostname: $want\$" "$made/cloudflared.yml")" == 1 ]] ||
  fail "the Deployed route file does not route $alias_deployed once: nothing was changed"
config="$(arg "$tunnel_source" --config)"
[[ -n $config ]] || fail "the tunnel's Deployed LaunchDaemon file names no route file: nothing was changed"
sed "s|<string>$config</string>|<string>$rehearsal/cloudflared.yml</string>|" "$tunnel_source" > "$made/tunnel.plist"
sed "s|<string>--alias</string><string>$alias_deployed</string>|<string>--alias</string><string>$want</string>|" "$labd_source" > "$made/labd.plist"
[[ "$(arg "$made/tunnel.plist" --config)" == "$rehearsal/cloudflared.yml" && "$(arg "$made/labd.plist" --alias)" == "$want" ]] ||
  fail "the Deployed LaunchDaemon files are not written as this script reads them: nothing was changed"

mkdir -p "$rehearsal"
cp "$made/cloudflared.yml" "$rehearsal/cloudflared.yml"
chown -R "$ROOT_OWNER:$ROOT_GROUP" "$rehearsal"
chmod 0755 "$rehearsal"
chmod 0644 "$rehearsal/cloudflared.yml"
# The tunnel first: labd looks at its Alias from outside as it starts.
start "$CLOUDFLARED_LABEL" "$made/tunnel.plist"
if ! up tunnel; then
  back
  fail "the tunnel did not connect with $want routed: both are back under the Deployed files"
fi
start "$LABD_LABEL" "$made/labd.plist"
if ! up labd; then
  back
  fail "labd did not answer with $want as its Alias: both are back under the Deployed files"
fi
say "labd forwards $want and the tunnel routes it, until \"rehearsal-alias deployed\""
