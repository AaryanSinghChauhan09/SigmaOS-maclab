#!/bin/bash
# Hardening's test 6: no secret shows in the process list or in a service
# definition on the mini (spec section 16, Ready item 8; section 12
# "Secrets: one rule").
#
#   h06-no-secret-shown [--dry-run | --local | --lab --mini USER@HOST] [--records DIR]
#
# The mini says it itself (scripts/mini/secrets-seen, as root): every secret
# of its two secrets folders is looked for in every process's command line
# and environment and in the lab's LaunchDaemon files and route file, and
# those are read for a secret given by value. Nothing but counts and file
# names comes back. Locally the same script reads a stand-in for the mini's
# folders: the secrets the labd started here reads, the repository's
# LaunchDaemon files, and this machine's processes.
set -euo pipefail
# shellcheck source=scripts/cutover/hardening/lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
usage() { sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

hd_options "$@"
no_rest
# For the tests of this test: a secret put where it must not be.
FAULT="${HARDENING_FAULT:-}"

if [[ $MODE == dry ]]; then
  cat <<PLAN
$ME: dry run. On the mini over SSH (the owner types the password sudo asks for), it would:
  1. run: ssh -t ${MINI:-USER@HOST} sudo $MINI_SCRIPTS/secrets-seen
     expects: secrets above 0, definitions above 0; in_processes=0, in_definitions=0, shapes=0
  2. write docs/acceptance/$(today)-hardening-06.md and its line in docs/acceptance/$RESULTS_NAME
Nothing comes back but counts and file names. Nothing was sent.
PLAN
  exit 0
fi
[[ $MODE != lab || -n $MINI ]] || fail "--lab needs --mini USER@HOST: the mini says it itself, over SSH. Nothing was done."

# before_lab: a stand-in for the mini's folders, with the made-up secrets
# the labd started here is given.
# shellcheck disable=SC2329
before_lab() {
  ROOT="$WORK/root"
  mkdir -p "$ROOT/usr/local/lab/secrets" "$ROOT/var/lab/secrets" "$ROOT/Library/LaunchDaemons" "$ROOT/usr/local/lab/current/deploy"
  chmod 700 "$ROOT/usr/local/lab/secrets" "$ROOT/var/lab/secrets"
  local f
  for f in usr/local/lab/secrets/oobd.token usr/local/lab/secrets/builder.token var/lab/secrets/cloudflared.token; do
    ( umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$ROOT/$f" )
  done
  cp "$ROOT/usr/local/lab/secrets/oobd.token" "$ROOT/var/lab/secrets/oobd.token"
  LOCAL_FLAGS+=("--oobd-token-file=$ROOT/var/lab/secrets/oobd.token")
  cp "$REPO"/deploy/*.plist "$ROOT/Library/LaunchDaemons/"
  cp "$REPO"/deploy/*.yml "$ROOT/usr/local/lab/current/deploy/"
}

begin 06 "no secret in the process list or a service definition on the mini"
if playing; then
  # What the labd started here reads is among the secrets looked for.
  cp "$WORK/sign-in/github-client-secret" "$WORK/sign-in/github-client-id" "$ROOT/var/lab/secrets/"
  cp "$WORK/machine-id-key" "$ROOT/var/lab/secrets/machine-id-key"
  case "$FAULT" in
    secret-in-definition)
      printf '<plist><dict><key>ProgramArguments</key><array><string>/usr/local/lab/current/bin/oobd</string><string>--token</string><string>%s</string></array></dict></plist>\n' \
        "$(cat "$ROOT/usr/local/lab/secrets/oobd.token")" > "$ROOT/Library/LaunchDaemons/org.omarchy-mac.lab.fault.plist" ;;
    secret-in-process)
      sh -c 'sleep 30; :' "$(cat "$ROOT/var/lab/secrets/cloudflared.token")" &
      PIDS+=($!) ;;
  esac
  LAB_SYSROOT="$ROOT" LAB_PROCESSES="^[^ ]*($BIN|$WORK)/" "$REPO/scripts/mini/secrets-seen" > "$WORK/seen.out" 2> "$WORK/seen.err" \
    || give_up "secrets-seen failed here: $(plain "$WORK/seen.err")"
  rec "a labd started here, given its secrets in files (the sign-in folder, the machine-id key, the controller's token), and the repository's LaunchDaemon files and route file, read as the mini's"
else
  say "asking the mini (sudo asks for the password there)"
  # shellcheck disable=SC2029
  ssh -t "$MINI" sudo "$MINI_SCRIPTS/secrets-seen" | tr -d '\r' | tee "$WORK/seen.raw" | grep -E '^[a-z_]+=' > "$WORK/seen.out" \
    || give_up "the mini gave no answer: is the Deployed build one that has scripts/mini/secrets-seen?"
fi
grep -E '^[a-z_]+=[A-Za-z0-9_.:/-]*$' "$WORK/seen.out" > "$WORK/facts" || true
f() { sed -n "s/^$1=//p" "$WORK/facts" | head -n 1; }
secrets="$(f secrets)" definitions="$(f definitions)"
rec "the mini looked for $secrets secret lines in $(f processes) processes and $definitions service definitions"
while IFS= read -r line; do rec "$line"; done < <(grep -E '^(seen|shape)=' "$WORK/facts" || true)
(( ${secrets:-0} > 0 )) || give_up "there was no secret to look for: are the secrets folders where the set-up puts them?"
(( ${definitions:-0} > 0 )) || give_up "there was no service definition to read"
[[ "$(f in_processes)" == 0 ]] || give_up "a secret shows in the process list ($(f in_processes))"
[[ "$(f in_definitions)" == 0 ]] || give_up "a secret shows in a service definition ($(f in_definitions))"
[[ "$(f shapes)" == 0 ]] || give_up "a secret is given by value ($(f shapes))"
rec "no secret shows in a process or a service definition, and none is given by value"
passed
