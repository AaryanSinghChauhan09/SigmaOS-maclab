#!/bin/bash
# The Front door's test 5: a large upload and download from a wired machine
# outside the house, with 1 part and with 4 parts at a time (spec section
# 16, Ready item 1 and step 14b; decisions S13 and S15).
#
# The machine is an M team member's and the login is theirs: the member
# runs fd05-member.sh, which the owner sends them with the draft in
# fd05-ask.md, and sends back nine numbers. This script is the owner's side:
#
#   fd05-outside-transfers [--dry-run]
#       What each step below would do. Sends nothing.
#   fd05-outside-transfers --lab --prepare [--mac m1-pro]
#       Runs the job that leaves the download's file on the Mac, under the
#       saved login, and prints the job id the member's command line needs.
#   fd05-outside-transfers --lab --rehearse --job ID
#       Runs the member's script from this machine, in the house, through
#       the Lab address, to prove it before it is sent. It installs lab from
#       the lab's install line, takes a Lease on the Mac under the saved
#       login, and decides nothing.
#   fd05-outside-transfers --lab --record FILE
#       FILE holds what the member sent back. It is refused when it holds
#       anything but the nine numbers. Under 50 Mbit/s the run says so and
#       stops for the owner (status 3). Otherwise how many parts go at once
#       is decided (4 only if at least 20% faster) and written in deploy/,
#       and the dated record goes to docs/acceptance/.
#   fd05-outside-transfers --local [--size BYTES]
#       All of it against a labd started on this machine's loopback, with a
#       simulated Mac and small files: the member's script, the reading of
#       its output and the decision, which is shown and written nowhere.
#
# Marking the member as M team on People and sending the message are the
# owner's: this script sends nothing to anyone.
set -euo pipefail
# shellcheck source=scripts/cutover/front-door/lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
usage() { sed -n '2,32p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

KEYS="fd05_format upload_bytes upload_1_seconds upload_1_mbit upload_4_seconds upload_4_mbit download_bytes download_seconds download_mbit"

fd_options "$@"
step=""
sent=""
set -- ${REST[@]+"${REST[@]}"}
while (( $# )); do
  case "$1" in
    --prepare|--rehearse) step="${1#--}" ;;
    --record) (( $# >= 2 )) || fail "--record needs the file with what the member sent back"; step=record; sent="$2"; shift ;;
    *) fail "an option it does not take: $1. Nothing was done." ;;
  esac
  shift
done

# numbers FILE: reads the member's nine numbers into variables named as the
# keys. Anything else in the file refuses it: what goes into the record is
# numbers only.
# shellcheck disable=SC2154
numbers() {
  local line key value seen=" "
  [[ -f $1 ]] || fail "no file $1"
  while IFS= read -r line || [[ -n $line ]]; do
    line="${line%$'\r'}"
    [[ -z ${line// /} || $line =~ ^-+$ ]] && continue
    if [[ ! $line =~ ^([a-z0-9_]+)=([0-9]+(\.[0-9]+)?)$ ]]; then
      fail "$1 holds a line that is not one of the nine numbers. It was not read further, and nothing was recorded: ask for the lines between the two rules only."
    fi
    key="${BASH_REMATCH[1]}" value="${BASH_REMATCH[2]}"
    [[ " $KEYS " == *" $key "* ]] || fail "$1 holds a number the member's script does not print. Nothing was recorded."
    [[ $seen != *" $key "* ]] || fail "$1 holds $key twice. Nothing was recorded."
    seen="$seen$key "
    printf -v "$key" '%s' "$value"
  done < "$1"
  for key in $KEYS; do
    [[ $seen == *" $key "* ]] || fail "$1 lacks $key. Nothing was recorded."
  done
  [[ $fd05_format == 1 ]] || fail "$1 is in a format this script does not read"
}

# decide: the record's lines, the stop under 50 Mbit/s, and the setting.
# shellcheck disable=SC2154
decide() {
  local status=0
  rec "upload, 1 part at a time: $upload_bytes bytes in $upload_1_seconds s, $upload_1_mbit Mbit/s"
  rec "upload, 4 parts at a time: $upload_bytes bytes in $upload_4_seconds s, $upload_4_mbit Mbit/s"
  rec "download: $download_bytes bytes in $download_seconds s, $download_mbit Mbit/s"
  "$FD_HERE/settle" outside "$upload_1_mbit" "$upload_4_mbit" "$download_mbit" > "$WORK/settle.out" || status=$?
  while IFS= read -r line; do rec "${line#settle: }"; done < "$WORK/settle.out"
  if (( status == 3 )); then
    record_done stopped
    exit 3
  fi
  (( status == 0 )) || { record_done fail; exit 1; }
  "$FD_HERE/settle" parts "$upload_1_mbit" "$upload_4_mbit" "$@" > "$WORK/settle.out" || { record_done fail; exit 1; }
  while IFS= read -r line; do rec "${line#settle: }"; done < "$WORK/settle.out"
  record_done pass
}

if [[ $MODE == dry ]]; then
  cat <<EOF
$ME: dry run. The steps, in order:
  1. --lab --prepare: under the saved login, run
       lab run $MAC --script scripts/cutover/front-door/transfer-file.sh
     which leaves $JOB_FILE ($JOB_FILE_BYTES bytes) among the job's files, and print the job id.
  2. --lab --rehearse --job ID: run fd05-member.sh ID from this machine through $ADDRESS:
       curl -fsSL $ADDRESS/install/lab | bash; lab lease $MAC;
       lab upload FILE --for $MAC (1 GiB, 1 part at a time, then 4); lab logs ID $JOB_FILE (until 1 GiB); lab release $MAC
  3. The owner marks the member as M team on People and sends them fd05-member.sh with the message drafted in fd05-ask.md.
  4. --lab --record FILE: read the nine numbers the member sent back; stop under 50 Mbit/s;
     else write --parts-at-once 1 or 4 (4 only if at least 20% faster) in deploy/org.omarchy-mac.lab.labd.plist
     and the record in docs/acceptance/$(TZ=Australia/Brisbane date +%Y-%m-%d)-front-door-05.md
Nothing was sent.
EOF
  exit 0
fi

workspace
case "$MODE:$step" in
  local:)
    [[ -n $SIZE ]] || SIZE=$((72 << 20))
    JOB_FILE_BYTES=$((8 << 20))
    local_lab
    local_mac
    transfer_job
    say "the member's script, against the labd started here"
    LAB_ADDRESS="$ADDRESS" LAB_MAC="$MAC" LAB_BYTES="$SIZE" LAB_COMMAND="$LAB_CMD" sh "$FD_HERE/fd05-member.sh" "$JOB" > "$WORK/sent" \
      || fail "the member's script failed"
    numbers "$WORK/sent"
    record_start 05 "a large upload and download from outside the house, 1 part and 4 parts at a time"
    decide --dry-run --deploy "$DEPLOY"
    ;;
  lab:prepare)
    logged_in
    transfer_job
    say "job $JOB on $MAC holds $JOB_FILE. The member's command line is: sh fd05-member.sh $JOB"
    ;;
  lab:rehearse)
    [[ -n $JOB ]] || fail "--rehearse needs --job ID, which --prepare printed"
    env LAB_ADDRESS="$ADDRESS" LAB_MAC="$MAC" ${SIZE:+LAB_BYTES="$SIZE"} sh "$FD_HERE/fd05-member.sh" "$JOB" > "$WORK/sent" \
      || fail "the member's script failed here: it is not ready to send"
    numbers "$WORK/sent"
    say "the member's script ran from this machine and printed the nine numbers and nothing else:"
    cat "$WORK/sent"
    say "from inside the house these decide nothing."
    ;;
  lab:record)
    numbers "$sent"
    record_start 05 "a large upload and download from outside the house, 1 part and 4 parts at a time"
    rec "from an M team member's wired machine, under the member's own login, with a Lease on $MAC; the numbers are the ones the member's script printed"
    decide --deploy "$DEPLOY"
    ;;
  lab:) fail "--lab needs one of --prepare, --rehearse or --record FILE" ;;
  *) fail "--$step goes with --lab" ;;
esac
