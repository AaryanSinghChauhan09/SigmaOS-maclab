/bin/
# A lab's own handoff for its agents: hosts, users, house rules. Keep it local.
LAB-FOR-AGENTS.md

# Python bytecode (the installed-mode collector is tested in place)
__pycache__/

# Local distribution output and generated Python caches
dist/
*.pyc
/loop/

# tla2tools.jar, fetched by make spec
/specs/.tools

# esprotation tests whose /tmp is tmpfs keep their archives here
/internal/esprotation/.test-*/

# Reports written by local runs of omarchy-m-test
omarchy-m-test-report.json

# A virtualenv for the Python tests
/.venv/

# The Rails reference
/site/.bundle/
/site/vendor/bundle/
/site/log/*
!/site/log/.keep
/site/tmp/*
!/site/tmp/.keep
/site/storage/
/site/config/master.key
/site/config/credentials/*.key
/site/.env*

# The cloud scripts' local names (scripts/cloud/lab.env.example)
/scripts/cloud/lab.env
