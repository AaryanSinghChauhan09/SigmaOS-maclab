#!/bin/bash
# Tell the owner one operations line:
#
#   scripts/mini/notify agents TEXT
#
# "agents" is the Signal group "Agents". Until the lab's Signal sender is on
# the mini this only writes the line to /var/lab/log/notify.log, with its
# time; nothing is sent anywhere.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/mini/lib.sh
. "$here/lib.sh"

[[ $# == 2 && $1 == agents && -n $2 ]] || { sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }
log="$LAB_HOME/log/notify.log"
no_link "$log"
printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$(tr '\n' ' ' <<<"$2")" >> "$log" || fail "could not write $log"
