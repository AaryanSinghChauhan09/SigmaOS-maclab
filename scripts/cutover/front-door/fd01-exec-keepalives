#!/bin/bash
# The Front door's test 1: a one-hour silent lab exec on a real Mac, with a
# Keepalive every 30 s from labd itself (spec section 16, Ready item 1;
# section 6, "Held responses").
#
#   fd01-exec-keepalives [--dry-run | --local | --lab] [--mac NAME] [--seconds N] [--records DIR]
#
# Under a Lease it takes on the Mac, two commands that print nothing for N
# seconds run at the same time. One is lab exec itself: it must come back
# with the command's own output and exit status. The other is sent by the
# probe under the same login, which writes down when each Keepalive came:
# the first at once, the next ones 30 s apart, none missing, and the result
# as the last line. Through the Lab address the edge cuts an answer that is
# silent for 125 s, so an hour held is an hour of Keepalives that arrived.
#
#   --seconds N   how long the commands are silent: 3590 through the Lab
#                 address (lab exec takes a timeout of an hour at most),
#                 70 against a local labd
#
# The two commands are kept in the Exec record, as every lab exec is.
set -euo pipefail
# shellcheck source=scripts/cutover/front-door/lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
# shellcheck source=scripts/cutover/front-door/edge.sh
. "$FD_HERE/edge.sh"
usage() { sed -n '2,21p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

fd_options "$@"
seconds=""
set -- ${REST[@]+"${REST[@]}"}
while (( $# )); do
  case "$1" in
    --seconds) (( $# >= 2 )) || usage; seconds="$2"; shift ;;
    *) fail "an option it does not take: $1. Nothing was done." ;;
  esac
  shift
done
if [[ -z $seconds ]]; then
  if [[ $MODE == local ]]; then seconds=70; else seconds=3590; fi
fi
[[ $seconds =~ ^[1-9][0-9]{0,3}$ ]] || fail "--seconds $seconds is not a number of seconds"
(( seconds >= 61 && seconds <= 3590 )) || fail "--seconds $seconds: from 61, so that three Keepalives are due, to 3590"
timeout=$((seconds + 10))
due=$((seconds / 30 + 1))

if [[ $MODE == dry ]]; then
  cat <<PLAN
$ME: dry run. Through $ADDRESS, under the saved login, it would:
  1. run: lab lease $MAC
  2. run: lab exec --timeout $timeout $MAC 'sleep $seconds; echo fd01-…' and want its output and exit status 0
  3. at the same time send the same kind of command with the probe and time the stream:
     a Keepalive within 5 s, then one every 30 s ($due in all), none more than 35 s after the one before, the result last
  4. run: lab release $MAC
  5. write docs/acceptance/$(TZ=Australia/Brisbane date +%Y-%m-%d)-front-door-01.md
The two commands stay in the Exec record. Nothing was sent.
PLAN
  exit 0
fi

edge_workspace
if [[ $MODE == local ]]; then
  # A silence of 45 s is cut here: a held response lives on its Keepalives.
  edge_lab 45s
  edge_mac
else
  logged_in
fi
record_start 01 "a silent lab exec is held on Keepalives from labd itself"
own_lease

mark="fd01-$(nonce)"
"$LAB_CMD" exec --timeout "$timeout" "$MAC" "sleep $seconds; echo $mark-lab" > "$WORK/exec.out" 2> "$WORK/exec.err" &
lab_pid=$!
"$PROBE" held --timeout "$timeout" exec "$MAC" "sleep $seconds; echo $mark-probe" > "$WORK/held.out" 2> "$WORK/held.err" \
  || failed "the probe could not send its command: $(plain "$WORK/held.err")"
lab_status=0
wait "$lab_pid" || lab_status=$?

held="$WORK/held.out"
case "$(fact "$held" ended)" in
  result) ;;
  refused) failed "labd refused the command (HTTP $(fact "$held" status)): $(fact "$held" said)" ;;
  silent_form) failed "labd answered in the silent form, with no Keepalive, after $(fact "$held" seconds) s: through the tunnel every lab exec is a stream" ;;
  cut) failed "the stream was cut after $(fact "$held" seconds) s and $(fact "$held" keepalives) Keepalives, the last line never came" ;;
  error) failed "the command failed on the way (status $(fact "$held" error_status)): $(fact "$held" said)" ;;
  *) failed "the probe's request did not reach the lab: $(fact "$held" said)" ;;
esac
count="$(fact "$held" keepalives)"
first="$(fact "$held" first)"
gap_min="$(fact "$held" gap_min)"
gap_max="$(fact "$held" gap_max)"
took="$(fact "$held" seconds)"
rec "the command was silent for $seconds s; its stream lasted $took s"
rec "Keepalives: $count; the first after ${first:-no} s; from ${gap_min:-0} s to ${gap_max:-0} s apart"
bad=0
if (( count < 1 )) || is "${first:-99} > 5"; then
  rec "FAIL: no Keepalive came within 5 s of the request"
  bad=1
fi
if (( count < due - 1 )); then
  rec "FAIL: $count Keepalives in $took s, where one every 30 s makes $due"
  bad=1
fi
if (( count > 1 )) && is "$gap_max > 35"; then
  rec "FAIL: $gap_max s passed between two Keepalives; labd sends one every 30 s"
  bad=1
fi
if [[ "$(fact "$held" exit_code)" != 0 ]] || [[ "$(fact "$held" stdout)" != *"$mark-probe"* ]]; then
  rec "FAIL: the last line was not the command's result"
  bad=1
else
  rec "the last line of the stream was the command's result, exit status 0"
fi
if (( lab_status != 0 )) || ! grep -q "$mark-lab" "$WORK/exec.out"; then
  rec "FAIL: lab exec, held for the same $seconds s, ended with status $lab_status: $(plain "$WORK/exec.err")"
  bad=1
else
  rec "lab exec, held for the same $seconds s, came back with the command's output and exit status 0"
fi
give_back
(( ! bad )) || { record_done fail; exit 1; }
record_done pass
