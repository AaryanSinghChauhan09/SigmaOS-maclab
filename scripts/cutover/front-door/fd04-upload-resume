#!/bin/bash
# The Front door's test 4: a 1 GB upload in parts, cut mid-part, resumes,
# and its checksum matches (spec section 16, Ready item 1).
#
#   fd04-upload-resume [--dry-run | --local | --lab --mini USER@HOST] [--size BYTES] [--records DIR]
#
# lab upload sends a file of random bytes in 32 MiB parts and says each part
# as labd takes it (MACLAB_UPLOAD_PROGRESS=1). Once lab says labd holds two
# or more, and not all, lab is stopped and labd's upload folder is read:
# labd writes a part into a file of its own there, which becomes the part
# only when it is whole. lab is killed only while such a file holds some of a
# part's bytes, and let go on otherwise, until it is: so the cut is inside a
# part, and seen to be. The same command, run again, must say that it
# resumes and that labd still holds at least the parts it held, and not all;
# it is left to finish, and the SHA-256 lab prints must be the file's. labd
# stores the file only under the SHA-256 the upload named, so a wrong byte
# anywhere fails the close.
#
#   --size BYTES      the file's size: 1 GiB through the Lab address,
#                     320 MiB (10 parts) against a local labd
#   --mini USER@HOST  through the Lab address: the mini, where labd's upload
#                     folder is read (ssh -t, sudo -u lab: the owner types
#                     the password)
set -euo pipefail
# shellcheck source=scripts/cutover/front-door/lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
usage() { sed -n '2,23p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

fd_options "$@"
no_rest
if [[ -z $SIZE ]]; then
  if [[ $MODE == local ]]; then SIZE=$((320 << 20)); else SIZE=$GIB; fi
fi
(( SIZE > 4 * PART_BYTES )) || fail "--size $SIZE: the file must be longer than four parts ($((4 * PART_BYTES)) bytes) for a cut after the second to leave some unsent"
parts=$(( (SIZE + PART_BYTES - 1) / PART_BYTES ))

if [[ $MODE == dry ]]; then
  cat <<PLAN
$ME: dry run. Through $ADDRESS, under the saved login, it would:
  1. make a file of $SIZE random bytes ($parts parts of 32 MiB) and take its SHA-256
  2. run: lab upload FILE; once labd holds two parts, stop it and read labd's upload folder (ssh -t MINI sudo -u lab find $MINI_DATA/artifacts/.upload-SHA256 ...), and kill it while labd holds part of a part
  3. run: lab upload FILE again, which must say "resuming: labd holds N of $parts parts" with 2 <= N < $parts
  4. let that run finish and compare the SHA-256 lab prints with the file's
  5. write docs/acceptance/$(TZ=Australia/Brisbane date +%Y-%m-%d)-front-door-04.md
Nothing was sent.
PLAN
  exit 0
fi

[[ $MODE != lab || -n $MINI ]] || fail "--lab needs --mini USER@HOST: labd's upload folder is read there, to see the cut inside a part"

workspace
if [[ $MODE == local ]]; then local_lab; else logged_in; fi
record_start 04 "an upload in parts, cut mid-part, resumes and its checksum matches"
give_up() {
  rec "$1"
  record_done fail
  exit 1
}

file="$WORK/upload.bin"
err="$WORK/run.err"
out="$WORK/run.out"
random_file "$file" "$SIZE"
want="$(sha256_of "$file")"
rec "file: $SIZE bytes, $parts parts of 32 MiB"

# held_now: how many parts lab last said labd holds.
held_now() { sed -n 's/^lab: labd holds \([0-9]*\) of [0-9]* parts$/\1/p' "$err" | tail -n 1; }

# partly_held: the most bytes labd holds of a part it does not hold whole,
# or nothing. A whole part not yet renamed is no part partly received.
last_part=$(( SIZE - (parts - 1) * PART_BYTES ))
partly_held() {
  local dir="artifacts/.upload-$want"
  {
    if [[ $MODE == local ]]; then
      find "$LOCAL_DATA/$dir" -maxdepth 1 -type f -name '.part-*' -size +0c -exec wc -c {} + 2> /dev/null
    else
      # shellcheck disable=SC2029
      ssh -t "$MINI" sudo -u lab find "$MINI_DATA/$dir" -maxdepth 1 -type f -name "'.part-*'" -size +0c -exec wc -c {} + | tee /dev/stderr | tr -d '\r'
    fi
  } | awk -v whole="$PART_BYTES" -v last="$last_part" '$2 ~ /\/\.part-/ && $1 != whole && $1 != last && $1 > most { most = $1 } END { if (most > 0) print most }' || true
}

# The first run, cut inside a part.
: > "$err"
MACLAB_UPLOAD_PROGRESS=1 "$LAB_CMD" upload "$file" > "$out" 2> "$err" &
pid=$!
# Parts may go four at a time and end in waves, so the time between two
# looks says nothing about how long the parts under way still need: lab is
# stopped the moment it is seen past one part, and labd is looked at then.
stopped="" two="" cut=""
while kill -0 "$pid" 2>/dev/null; do
  n="$(held_now)"
  if [[ ${n:-0} -ge 2 ]]; then
    two=1
    (( n < parts )) || break
    kill -STOP "$pid" 2>/dev/null || break
    cut="$(partly_held)"
    if [[ -n $cut ]]; then
      stopped=1
      break
    fi
    kill -CONT "$pid" 2>/dev/null || break
  fi
  sleep 0.02
done
if [[ -z $stopped ]]; then
  kill -9 "$pid" 2>/dev/null || true
  if ! wait "$pid" && [[ -z $two ]]; then
    give_up "lab upload failed before any cut: $(plain "$err")"
  fi
  [[ -n $two ]] || give_up "lab upload ended before labd was seen to hold two parts: no cut was made"
  give_up "lab upload was never stopped while labd held part of a part: no cut inside a part was made"
fi
before="$(held_now)"
kill -9 "$pid" 2>/dev/null || give_up "lab upload ended before the cut"
wait "$pid" 2>/dev/null || true
rec "cut: lab upload killed while it sent, with $before of $parts parts taken by labd and $cut bytes of another received"

# The same command again.
start="$(now)"
got="$("$LAB_CMD" upload "$file" 2> "$err")" || give_up "the run after the cut failed: $(plain "$err")"
held="$(sed -n 's/^lab: resuming: labd holds \([0-9]*\) of \([0-9]*\) parts$/\1 \2/p' "$err" | head -n 1)"
[[ -n $held ]] || give_up "the run after the cut did not say it resumed: it sent the file from its start"
[[ ${held#* } == "$parts" ]] || give_up "lab counts ${held#* } parts in a file of $parts"
held="${held% *}"
(( held >= before )) || give_up "labd held $before parts at the cut and only $held after it: parts were lost"
(( held < parts )) || give_up "labd held every part after the cut: nothing was left to resume"
rec "resume: labd held $held of $parts parts; the same command sent the other $((parts - held)) in $(calc "$(now) - $start") s"
[[ $got == "$want" ]] || give_up "checksum: labd stored another SHA-256 than the file's"
rec "checksum: the SHA-256 labd stored is the file's"
record_done pass
