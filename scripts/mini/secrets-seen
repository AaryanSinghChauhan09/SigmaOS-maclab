#!/bin/bash
# What Hardening's test 6 asks the mini itself: does a secret show in the
# process list or in a service definition (spec section 16, Ready item 8;
# section 12 "Secrets: one rule"). It changes nothing and prints counts and
# file names only: never a secret, never a command line.
#
#   sudo scripts/mini/secrets-seen
#
# Every line of every file in the two secrets folders (root's,
# /usr/local/lab/secrets, and the lab account's, /var/lab/secrets) that is
# long enough to be a secret is looked for in every process's command line
# and environment, and in the lab's service definitions: its LaunchDaemon
# files and the Deployed route file. The lab's own processes and the
# definitions are also read for the shapes a secret takes when it is given
# by value: a --token, --password or --secret flag with a value that is no
# file, a TOKEN=, PASSWORD= or SECRET= variable that is no file, a
# Tailscale auth key, a Lab token, a Join command's token.
#
#   secrets=N          secret lines looked for (0: nothing to look for)
#   processes=N        processes read
#   definitions=N      service definitions read
#   in_processes=N     secrets seen in a process
#   in_definitions=N   secrets seen in a definition
#   shapes=N           secrets given by value, by their shape
#   seen=FILE:WHERE    which secret file's line was seen, and where
#   shape=WHAT:WHERE   a shape, and the definition or process it is in
#
# A secret is passed to grep in a file only root reads, never as an
# argument. Needs only what macOS has.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/mini/lib.sh
. "$here/lib.sh"

usage() { sed -n '2,29p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }
(( $# == 0 )) || usage
need_root

# Which processes are the lab's: their command names a path of the lab's.
LAB_PROCESSES="${LAB_PROCESSES:-^[^ ]*(/usr/local/lab/|/var/lab/)}"
SHORTEST=12

t="$(mktemp -d "${TMPDIR:-/tmp}/secrets-seen.XXXXXX")"
chmod 700 "$t"
trap 'rm -rf "$t"' EXIT

# Every process: its command line, and its environment where ps shows it.
{ ps -A -ww -E -o command= 2>/dev/null || ps -A -ww -o command= e 2>/dev/null || ps -A -ww -o command=; } | grep -v 'secrets-seen' > "$t/processes" || true
grep -E "$LAB_PROCESSES" "$t/processes" > "$t/lab-processes" || true

: > "$t/definitions.list"
for f in "$LAUNCHD_DIR"/org.omarchy-mac.lab.*.plist "$OOBD_PLIST" "$LAB_CURRENT"/deploy/*.yml; do
  [[ -f $f && ! -L $f ]] && echo "$f" >> "$t/definitions.list"
done

secrets=0 in_processes=0 in_definitions=0 shapes=0
for dir in "$LAB_SECRETS" "$LAB_HOME/secrets"; do
  [[ -d $dir ]] || continue
  while IFS= read -r -d '' file; do
    (( $(wc -c < "$file") <= 65536 )) || continue
    # The lines long enough to be a secret, without spaces around them.
    sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$file" | awk -v n="$SHORTEST" 'length($0) >= n' > "$t/patterns" || true
    [[ -s $t/patterns ]] || continue
    secrets=$(( secrets + $(wc -l < "$t/patterns") ))
    name="${file#"$SYSROOT"}"
    if grep -qF -f "$t/patterns" "$t/processes"; then
      in_processes=$(( in_processes + 1 ))
      echo "seen=$name:processes"
    fi
    while IFS= read -r def; do
      if grep -qF -f "$t/patterns" "$def"; then
        in_definitions=$(( in_definitions + 1 ))
        echo "seen=$name:$(basename "$def")"
      fi
    done < "$t/definitions.list"
  done < <(find "$dir" -type f -print0 2>/dev/null)
done
rm -f "$t/patterns"

# The shapes. A flag or a variable whose value is a file is the rule kept.
FLAG='--[a-z-]*(token|password|secret|passphrase)[= ]+[^/ -]'
VARIABLE='(^|[ ;"])[A-Z_]*(TOKEN|PASSWORD|SECRET|PASSPHRASE)=[^/ ]'
VALUES='tskey-[A-Za-z0-9]|lab_[0-9a-f]{40}|enr_[0-9a-f]{32}'
shape() {
  local what="$1" text="$2"
  if grep -qiE -- "$FLAG" <<<"$text"; then echo "flag"; fi
  if grep -qE -- "$VARIABLE" <<<"$text"; then echo "variable"; fi
  if grep -qE -- "$VALUES" <<<"$text"; then echo "value"; fi
  if [[ $what == plist ]] && grep -qE '<key>[A-Za-z_]*(TOKEN|PASSWORD|SECRET|PASSPHRASE)</key>[[:space:]]*<string>[^/<]' <<<"$text"; then echo "variable"; fi
}
while IFS= read -r line; do
  for s in $(shape process "$line" | sort -u); do
    shapes=$(( shapes + 1 ))
    echo "shape=$s:$(basename "${line%% *}")"
  done
done < "$t/lab-processes"
while IFS= read -r def; do
  flat="$(tr '\n' ' ' < "$def")"
  # shellcheck disable=SC2001
  args="$(sed -e 's/<[^>]*>/ /g' <<<"$flat" | tr -s ' ')"
  for s in $( { shape plist "$flat"; shape args "$args"; } | sort -u); do
    shapes=$(( shapes + 1 ))
    echo "shape=$s:$(basename "$def")"
  done
done < "$t/definitions.list"

echo "secrets=$secrets"
echo "processes=$(wc -l < "$t/processes" | tr -d ' ')"
echo "definitions=$(wc -l < "$t/definitions.list" | tr -d ' ')"
echo "in_processes=$in_processes"
echo "in_definitions=$in_definitions"
echo "shapes=$shapes"
