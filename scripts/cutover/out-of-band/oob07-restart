#!/bin/bash
# Out-of-band wiring's test 7: the controller as a root LaunchDaemon: after
# an Unlock and after a planned restart, Sightings rebuild unaided (spec
# section 16, Ready item 2; section 7 "Sighting"; section 13 "Unlock and
# restarts").
#
#   oob07-restart [--dry-run | --local | --lab --mini USER@HOST] [--lab-back MINUTES]
#                 [--m1 NAME] [--m2 NAME] [--records DIR]
#
# A Mac the lab sighted by the name it shows must be sighted again, on the
# same port, by nobody's doing, once the mini is back: first after a restart
# from cold, which needs the Unlock, then after a planned restart, which
# needs none. A Mac that was placed by a Proving reset shows no name and is
# not sighted again by itself; the record says so, and it is no failure.
# Nothing is reset.
#
#   --lab-back MINUTES  how long the lab may take to answer again after
#                       Enter is pressed (default 15)
set -euo pipefail
# shellcheck source=scripts/cutover/out-of-band/lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
usage() { sed -n '2,18p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

oob_options "$@"
lab_back=15
if (( ${#REST[@]} )); then
  [[ ${REST[0]} == --lab-back && ${#REST[@]} == 2 && ${REST[1]} =~ ^[1-9][0-9]*$ ]] || fail "an option it does not take: ${REST[0]}. Nothing was done."
  lab_back="${REST[1]}"
fi
COLD="Restart the mini from cold: on the mini, sudo shutdown -r now. When it is up, do the Unlock (FileVault's password at the mini, or from outside the house through omarchy-gpu). Touch no cable and no test Mac."
PLANNED="Restart the mini as a Maintenance run does: on the mini, sudo fdesetup authrestart. It needs no Unlock. Touch no cable and no test Mac."

if [[ $MODE == dry ]]; then
  cat <<PLAN
$ME: dry run. Through $ADDRESS, under the saved login of a Maintainer, and on the mini over SSH, it would:
  1. note which of $M1 and $M2 the lab sights by the name they show (lab oob)
     expects: at least one
  2. look at the controller on the mini: launchctl print system/$OOBD_LABEL, and who owns $OOBD_PLIST
     expects: a LaunchDaemon that runs, as root, from a file that is root's
  3. STOP, by hand: $COLD
  4. wait for the lab to answer again, up to $lab_back minutes, then up to 2 minutes more
     expects: each Mac noted in step 1 is sighted again on the same port, with a Sighting newer than the restart, and the controller is healthy; nobody did anything
  5. STOP, by hand: $PLANNED
  6. wait as in step 4
     expects: the same
  7. write docs/acceptance/$(today)-out-of-band-07.md and its line in docs/acceptance/$RESULTS_NAME
Nothing was sent and nothing is reset by this test.
PLAN
  exit 0
fi

begin 07 "the controller as a root LaunchDaemon: after an Unlock and after a planned restart, Sightings rebuild unaided"

named=""
for mac in "$M1" "$M2"; do
  wait_until "$(if playing; then echo 25; else echo 45; fi)" is_placed "$mac" || true
  port="$(port_of "$mac")"
  if [[ -n $port ]] && by_name "$mac" "$port"; then
    named="$named $mac:$port"
    rec "before: $mac is sighted on the $port port by the name it shows"
  else
    rec "before: $mac is $(cable_of "$mac"): it shows the lab no name, so no restart can sight it again by itself; a Maintainer proves its port again"
  fi
done
[[ -n $named ]] || give_up "no Mac is sighted by the name it shows: there is no Sighting that could rebuild by itself"

if playing; then
  rec "the controller: made up here, and no LaunchDaemon"
else
  # shellcheck disable=SC2029
  ssh "$MINI" launchctl print "system/$OOBD_LABEL" > "$WORK/launchd.out" 2> "$WORK/ssh.err" || give_up "launchd on the mini does not know $OOBD_LABEL: $(plain "$WORK/ssh.err")"
  grep -qE 'state = running' "$WORK/launchd.out" || give_up "the controller is not running under launchd: $(grep -m 1 'state = ' "$WORK/launchd.out")"
  # shellcheck disable=SC2029
  owner="$(ssh "$MINI" stat -f '%Su:%Lp' "$OOBD_PLIST" 2>/dev/null)"
  # shellcheck disable=SC2029
  runs_as="$(ssh "$MINI" ps -axo user=,comm= 2>/dev/null | awk '$2 ~ /\/oobd$/ { print $1 }' | head -n 1)"
  [[ $owner == root:6[04][04] && $runs_as == root ]] || give_up "the controller is not root's LaunchDaemon: its file is $owner, its process runs as ${runs_as:-nobody}"
  rec "the controller: $OOBD_LABEL runs under launchd in the system domain, as root, from a file that is root's ($owner)"
fi

# after WHAT INSTRUCTION: one restart of the mini and what must follow.
after() {
  local pair mac port asked since
  asked="$(date '+%Y-%m-%d %H:%M:%S')"
  hands "$2"
  if playing; then
    fake restart
    restart_labd
  fi
  wait_until "$((lab_back * 60))" "$LAB_CMD" status "$M1" > /dev/null 2>&1 || give_up "$1: the lab did not answer again within $lab_back minutes"
  for pair in $named; do
    mac="${pair%%:*}"
    port="${pair##*:}"
    wait_until 120 by_name "$mac" "$port" || give_up "$1: $mac was not sighted again on the $port port within 2 minutes of the lab answering: $(cable_of "$mac")"
    since="$("$LAB_CMD" oob "$mac" 2>/dev/null | sed -n 's/^  since: *//p')"
    [[ -n $since && ! $since < $asked ]] || give_up "$1: the Sighting of $mac is from $since, before the restart was asked at $asked: labd did not start again"
    rec "$1: $mac is sighted again on the $port port, since $since, unaided"
  done
  "$LAB_CMD" oob "$M1" 2>/dev/null | grep -q '^  controller:  *healthy' || give_up "$1: the lab does not say the controller is healthy: $("$LAB_CMD" oob "$M1" 2>/dev/null | sed -n 's/^  controller: *//p')"
  rec "$1: the lab says the controller is healthy"
}
after "after an Unlock" "$COLD"
after "after a planned restart" "$PLANNED"
passed
