# Names the cloud scripts read from lab.env, beside this file. lab.env is not
# committed. Nothing here is a secret: no token and no key goes in it.

# The Cloudflare account that holds the zones: the long hex string after
# dash.cloudflare.com/ in the dashboard's address bar. Only making a new zone
# needs it; every other script reads it from the zone.
CLOUDFLARE_ACCOUNT_ID=
