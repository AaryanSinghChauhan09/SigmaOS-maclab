#!/bin/bash
# The lab's Signal sender: its number, its two groups, a test line.
#
#   sudo scripts/mini/signal [--dry-run] link
#   sudo scripts/mini/signal [--dry-run] register
#   sudo scripts/mini/signal [--dry-run] groups
#   sudo scripts/mini/signal [--dry-run] accept GROUP-ID
#   sudo scripts/mini/signal [--dry-run] group lab|agents GROUP-ID
#   sudo scripts/mini/signal [--dry-run] test
#
# link      links the sender to the owner's own number as a device named
#           "Omarchy Mac Lab": it shows a QR code (it needs Homebrew's
#           qrencode) to scan in Signal on his phone, under Settings, Linked
#           devices. Lines then come from his own number.
# register  or: asks for a number of the sender's own, the captcha link and
#           the code Signal sends by SMS, and registers it with signal-cli.
# groups    lists the groups the sender was added to, with their ids. What
#           members wrote there is fetched and thrown away, never shown.
# accept    accepts the invitation to a group, when the sender was invited
#           and not added.
# group     gives labd a group's id: lab is the Lab group ("Omarchy Mac
#           Lab"), agents is "Agents". From then on labd posts that group's
#           lines; until then it records them and posts none.
# test      has labd's own sender post one test line to each group.
#
# signal-cli runs as the lab account, from the copy of the Homebrew tools
# that only root can write; the account's keys are files of the lab account.
# The sender's daemon is stopped while link, register, groups and accept run, and
# started again after.
#
#   --dry-run  say what would be asked and run, and change nothing
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/mini/lib.sh
. "$here/lib.sh"

usage() { sed -n '2,31p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

while [[ ${1:-} == --dry-run ]]; do
  DRY=1
  shift
done
verb="${1:-}"
[[ -n $verb ]] || usage
shift
(( DRY )) || need_root

GROUP_ID='^[A-Za-z0-9+/]{43}=$'
secrets="$LAB_HOME/secrets"
no_planted_link

cli() { as_lab "$SIGNAL_CLI" --data-dir "$SIGNAL_DATA" "$@"; }

ready() {
  [[ -x $SIGNAL_CLI && -d $SIGNAL_DATA && -f $SIGNAL_PLIST ]] || fail "the Signal sender is not set up: run scripts/mini/setup first"
}

# ask PROMPT: one line from the terminal, into $answer.
ask() {
  answer=""
  printf '%s: ' "$1" >&2
  IFS= read -r answer || true
}

# The daemon holds the account's files: it is stopped while signal-cli runs
# by hand, and started again however that ends.
WAS_LOADED=0
alone() {
  if loaded "$SIGNAL_LABEL"; then
    WAS_LOADED=1
    say "stopping $SIGNAL_LABEL while signal-cli runs here"
    stop_sender
  fi
  trap back EXIT
}
back() {
  if (( WAS_LOADED )); then
    say "starting $SIGNAL_LABEL again"
    start_sender
  fi
}

register() {
  local number captcha code
  ask "The sender's number, with its country code (+61...)"
  number="$answer"
  [[ $number =~ ^\+[1-9][0-9]{6,14}$ ]] || fail "that is not a number with its country code. Nothing was changed"
  ask "The captcha link: solve https://signalcaptchas.org/registration/generate.html, then copy the address of \"Open Signal\" (signalcaptcha://...)"
  captcha="$answer"
  [[ $captcha == signalcaptcha://* ]] || fail "that is not a captcha link: it starts with signalcaptcha://. Nothing was changed"
  alone
  cli -a "$number" register --captcha "$captcha" || fail "signal-cli did not register the number"
  ask "The code Signal sent to that number by SMS"
  code="${answer//[- ]/}"
  [[ $code =~ ^[0-9]{6}$ ]] || fail "that is not a six-digit code. Run register again for a new one"
  cli -a "$number" verify "$code" || fail "signal-cli did not verify the number"
  cli -a "$number" updateProfile --given-name "Omarchy Mac Lab" || say "the profile name was not set: members see the number alone"
  say "registered. Add the number to \"Agents\" and to the group \"Omarchy Mac Lab\", then: scripts/mini/signal groups"
}

DEVICE_NAME="Omarchy Mac Lab"

# qrencode, from the copy of the tools or else Homebrew's, run as the lab
# account; it reads the link on its input, so no command line holds it.
qrencode() {
  local q
  for q in "$LAB_TOOLS/current/qrencode/bin/qrencode" "$BREW_PREFIX/bin/qrencode"; do
    [[ -x $q ]] && { echo "$q"; return 0; }
  done
  return 1
}

# show_link QRENCODE: signal-cli link's output, with the link shown as a QR code.
show_link() {
  local line
  while IFS= read -r line; do
    if [[ $line == sgnl://* ]]; then
      echo "In Signal on your phone: Settings, Linked devices, Link a new device, and scan:" >&2
      printf '%s' "$line" | as_lab "$1" -t ansiutf8 >&2 || echo "(qrencode failed: the link is not shown. Stop with Ctrl-C and run link again)" >&2
      echo "Waiting for the phone..." >&2
    else
      printf '%s\n' "$line"
    fi
  done
}

# The link is never printed, nor traced: whoever has it can link a device.
link() {
  local q
  set +x
  q="$(qrencode)" || fail "no qrencode here, and the link is shown only as a QR code: install it as the account /opt/homebrew belongs to (brew install qrencode) and run link again. Nothing was changed"
  alone
  cli link -n "$DEVICE_NAME" | show_link "$q" || fail "signal-cli did not link: run link again for a new QR code"
  say "linked as \"$DEVICE_NAME\", a device of your number: lines come from your own number. Then: scripts/mini/signal groups"
}

groups() {
  alone
  cli receive --ignore-attachments --ignore-stories --ignore-avatars --ignore-stickers >/dev/null || fail "signal-cli could not fetch what waits for the sender"
  cli listGroups || fail "signal-cli could not list the groups"
  say "give labd each id: scripts/mini/signal group lab ID, scripts/mini/signal group agents ID"
}

accept() {
  [[ ${1:-} =~ $GROUP_ID ]] || fail "that is not a group id as scripts/mini/signal groups prints it"
  alone
  cli updateGroup -g "$1" || fail "signal-cli did not accept the invitation"
}

# put NAME VALUE: the file NAME in the secrets folder, for the lab account alone.
put() { printf '%s\n' "$2" | lab_file "$secrets/$1"; }

group() {
  local file
  case "${1:-}" in
    lab) file=signal-lab-group ;;
    agents) file=signal-agents-group ;;
    *) usage ;;
  esac
  [[ ${2:-} =~ $GROUP_ID ]] || fail "that is not a group id as scripts/mini/signal groups prints it. Nothing was changed"
  [[ -d $secrets ]] || fail "no $secrets: run scripts/mini/setup first"
  change "give labd the id of the $1 group in $secrets/$file" put "$file" "$2"
  (( DRY )) || say "labd posts that group's lines from now on: scripts/mini/signal test"
}

test_line() {
  [[ -x $LAB_CURRENT/bin/labd ]] || fail "no build is Deployed: the test line is sent by labd's own sender"
  loaded "$SIGNAL_LABEL" || fail "$SIGNAL_LABEL is not running: run scripts/mini/setup"
  as_lab "$LAB_CURRENT/bin/labd" --signal-socket "$SIGNAL_SOCKET" --signal "$secrets" --signal-test
}

case "$verb" in
  link | register | groups | accept | test)
    if (( DRY )); then
      case "$verb" in
        link) say "would stop $SIGNAL_LABEL, link signal-cli as $LAB_OWNER to your number as the device \"$DEVICE_NAME\" by a QR code you scan on your phone, and start $SIGNAL_LABEL again" ;;
        register) say "would stop $SIGNAL_LABEL, ask for the number, the captcha link and the SMS code, register the number with signal-cli as $LAB_OWNER, and start $SIGNAL_LABEL again" ;;
        groups) say "would stop $SIGNAL_LABEL, fetch and throw away what waits for the sender, list its groups with their ids, and start $SIGNAL_LABEL again" ;;
        accept) say "would stop $SIGNAL_LABEL, accept the invitation to the group, and start $SIGNAL_LABEL again" ;;
        test) say "would have labd's sender post one test line to each group that has an id" ;;
      esac
      exit 0
    fi
    ready
    case "$verb" in
      link) link ;;
      register) register ;;
      groups) groups ;;
      accept) accept "$@" ;;
      test) test_line ;;
    esac
    ;;
  group) group "$@" ;;
  *) usage ;;
esac
